<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/karl/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/karl/css/font-awesome.min.css" />
    <style>
        body { display: flex; min-height: 100vh; flex-direction: column; }
        .wrapper { display: flex; flex: 1; }
        .sidebar { width: 250px; background: #343a40; color: white; min-height: 100vh; padding-top: 20px; }
        .sidebar a { color: #c2c7d0; display: block; padding: 12px 20px; text-decoration: none; }
        .sidebar a:hover, .sidebar a.active { background: #495057; color: white; }
        .content { flex: 1; padding: 20px; background: #f4f6f9; }
    </style>
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar Navigation -->
        <div class="sidebar">
            <h4 class="text-center text-white mb-4">KARL ADMIN</h4>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="active"><i class="fa fa-dashboard mr-2"></i> Dashboard</a>
            <a href="#"><i class="fa fa-list mr-2"></i> Quản lý Danh mục</a>
            <a href="#"><i class="fa fa-cube mr-2"></i> Quản lý Sản phẩm</a>
            <a href="#"><i class="fa fa-shopping-cart mr-2"></i> Quản lý Đơn hàng</a>
            <hr class="bg-secondary" />
            <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank"><i class="fa fa-globe mr-2"></i> Xem Trang Web (Client)</a>
        </div>

        <!-- Main Content -->
        <div class="content">
            @RenderBody()
        </div>
    </div>

    <script src="~/karl/js/jquery/jquery-2.2.4.min.js"></script>
    <script src="~/karl/js/bootstrap.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>