<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="description" content="">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>@ViewData["Title"] - Karl Fashion</title>

    <!-- Favicon -->
    <link rel="icon" href="~/karl/img/core-img/favicon.ico">

    <!-- Core Style CSS -->
    <link rel="stylesheet" href="~/karl/css/core-style.css">

    <!-- Style CSS -->
    <link rel="stylesheet" href="~/karl/style.css">

    <!-- Responsive CSS -->
    <link rel="stylesheet" href="~/karl/css/responsive.css">
</head>

<body>
    <!-- 1. Categories Side Menu Partial -->
    <partial name="_SideMenuPartial" />

    <div id="wrapper">
        <!-- 2. Header Partial -->
        <partial name="_HeaderPartial" />

        <!-- 3. Dynamic Body Content -->
        <main role="main">
            @RenderBody()
        </main>

        <!-- 4. Footer Partial -->
        <partial name="_FooterPartial" />
    </div>

    <!-- Scripts -->
    <script src="~/karl/js/jquery/jquery-2.2.4.min.js"></script>
    <script src="~/karl/js/popper.min.js"></script>
    <script src="~/karl/js/bootstrap.min.js"></script>
    <script src="~/karl/js/plugins.js"></script>
    <script src="~/karl/js/active.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>