<!-- Footer Area Start -->
<footer class="footer_area">
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="single_footer_area">
                    <div class="footer-logo">
                        <img src="~/karl/img/core-img/logo.png" alt="Logo">
                    </div>
                    <div class="copywrite_text d-flex align-items-center">
                        <p>
                            Bản quyền &copy; @DateTime.Now.Year Bảo lưu mọi quyền |
                            Thiết kế bởi <a href="https://colorlib.com" target="_blank">Colorlib</a>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                <div class="single_footer_area">
                    <ul class="footer_widget_menu">
                        <li><a href="#">Giới thiệu</a></li>
                        <li><a href="#">Bài viết</a></li>
                        <li><a href="#">Hỏi đáp</a></li>
                        <li><a href="#">Chính sách đổi trả</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                <div class="single_footer_area">
                    <ul class="footer_widget_menu">
                        <li><a href="#">Tài khoản của tôi</a></li>
                        <li><a href="#">Giao hàng</a></li>
                        <li><a href="#">Điều khoản sử dụng</a></li>
                        <li><a href="#">Chương trình đối tác</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <div class="single_footer_area">
                    <div class="footer_heading mb-30">
                        <h6>Đăng ký nhận bản tin khuyến mãi</h6>
                    </div>
                    <div class="subscribtion_form">
                        <form action="#" method="post">
                            <input type="email" name="mail" class="mail" placeholder="Nhập địa chỉ email của bạn...">
                            <button type="submit" class="submit">Đăng ký</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="line"></div>
        <div class="footer_bottom_area">
            <div class="row">
                <div class="col-12">
                    <div class="footer_social_area text-center">
                        <a href="#"><i class="fa fa-pinterest" aria-hidden="true"></i></a>
                        <a href="#"><i class="fa fa-facebook" aria-hidden="true"></i></a>
                        <a href="#"><i class="fa fa-twitter" aria-hidden="true"></i></a>
                        <a href="#"><i class="fa fa-linkedin" aria-hidden="true"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>
<!-- Footer Area End -->