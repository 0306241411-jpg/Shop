@using Microsoft.AspNetCore.Http
@using Shop
@using Shop.Models
@{
    // Lấy giỏ hàng từ Session
    var cart = Context.Session.GetObject<List<CartItem>>("MY_SHOP_CART") ?? new List<CartItem>();
    var totalQuantity = cart.Sum(x => x.Quantity);
}

<!-- ****** Header Area Start ****** -->
<header class="header_area">
    <!-- Top Header Area Start -->
    <div class="top_header_area">
        <div class="container h-100">
            <div class="row h-100 align-items-center justify-content-end">
                <div class="col-12 col-lg-7">
                    <div class="top_single_area d-flex align-items-center justify-content-end">
                        <!-- Logo Area -->
                        <div class="top_logo">
                            <a asp-controller="Home" asp-action="Index">
                                <img src="~/karl/img/core-img/logo.png" alt="Karl Fashion">
                            </a>
                        </div>
                        <!-- Cart Area -->
                        <div class="header-cart-menu d-flex align-items-center ml-auto">
                            <div class="cart">
                                <a asp-controller="Shop" asp-action="Cart" id="header-cart-btn" style="position: relative; display: inline-flex; align-items: center; gap: 6px;">
                                    <span class="ti-bag"></span> 
                                    <span>Your Bag</span> 
                                    <span class="cart_quantity" style="background: #ff084e; color: #fff; border-radius: 50%; padding: 2px 7px; font-size: 11px; font-weight: bold; line-height: 1.2;">
                                        @totalQuantity
                                    </span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Header Area Start -->
    <div class="main_header_area">
        <div class="container h-100">
            <div class="row h-100">
                <div class="col-12 d-md-flex justify-content-between">
                    <!-- Header Social Area -->
                    <div class="header-social-area">
                        <span class="karl-level">Share</span>
                        <a href="#"><i class="fa fa-pinterest" aria-hidden="true"></i></a>
                        <a href="#"><i class="fa fa-facebook" aria-hidden="true"></i></a>
                        <a href="#"><i class="fa fa-twitter" aria-hidden="true"></i></a>
                        <a href="#"><i class="fa fa-linkedin" aria-hidden="true"></i></a>
                    </div>
                    <!-- Menu Area -->
                    <div class="main-menu-area">
                        <nav class="navbar navbar-expand-lg align-items-start">
                            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#karl-navbar" aria-controls="karl-navbar" aria-expanded="false" aria-label="Toggle navigation">
                                <span class="navbar-toggler-icon"><i class="ti-menu"></i></span>
                            </button>
                            <div class="collapse navbar-collapse align-items-start collapse" id="karl-navbar">
                                <ul class="navbar-nav animated" id="nav">
                                    <li class="nav-item active"><a class="nav-link" asp-controller="Home" asp-action="Index">HOME</a></li>
                                    <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index">SHOP</a></li>
                                    <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Details" asp-route-id="1">SHOP DETAIL</a></li>
                                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">CONTACT</a></li>
                                </ul>
                            </div>
                        </nav>
                    </div>
                    <!-- Help Line -->
                    <div class="help-line-heading">
                        <a href="tel:+346573556778"><i class="ti-headphone-alt"></i> +34 657 3556 778</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
<!-- ****** Header Area End ****** -->