@{
    ViewData["Title"] = "Trang chủ";
}

<!-- ****** Khung Khuyến Mãi Đầu Trang ****** -->
<section class="top-discount-area d-md-flex align-items-center">
    <div class="single-discount-area">
        <h5>Miễn phí vận chuyển &amp; Đổi trả</h5>
        <h6><a href="#">MUA NGAY</a></h6>
    </div>
    <div class="single-discount-area">
        <h5>Giảm giá 20% cho tất cả váy</h5>
        <h6>MÃ GIẢM GIA: KarlFashion</h6>
    </div>
    <div class="single-discount-area">
        <h5>Giảm giá 20% cho sinh viên</h5>
        <h6>MÃ GIẢM GIÁ: StudentKarl</h6>
    </div>
</section>

<!-- ****** Welcome Slides Area ****** -->
<section class="welcome_area">
    <div class="welcome_slides owl-carousel">
        <div class="single_slide height-800 bg-img background-overlay"
             style="background-image: url('@Url.Content("~/karl/img/bg-img/bg-1.jpg")');">
            <div class="container h-100">
                <div class="row h-100 align-items-center">
                    <div class="col-12">
                        <div class="welcome_slide_text">
                            <h6 data-animation="bounceInDown" data-delay="0" data-duration="500ms">* Ưu đãi duy nhất hôm nay: Miễn phí giao hàng</h6>
                            <h2 data-animation="fadeInUp" data-delay="500ms" data-duration="500ms">Xu hướng Thời trang</h2>
                            <a asp-controller="Shop" asp-action="Index" class="btn karl-btn" data-animation="fadeInUp"
                               data-delay="1s" data-duration="500ms">Mua ngay</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="single_slide height-800 bg-img background-overlay"
             style="background-image: url('/karl/img/bg-img/bg-4.jpg');">
            <div class="container h-100">
                <div class="row h-100 align-items-center">
                    <div class="col-12">
                        <div class="welcome_slide_text">
                            <h6 data-animation="fadeInDown" data-delay="0" data-duration="500ms">* Ưu đãi duy nhất hôm nay: Miễn phí giao hàng</h6>
                            <h2 data-animation="fadeInUp" data-delay="500ms" data-duration="500ms">Bộ sưu tập Mùa hè</h2>
                            <a asp-controller="Shop" asp-action="Index" class="btn karl-btn"
                               data-animation="fadeInLeftBig" data-delay="1s" data-duration="500ms">Xem bộ sưu tập</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="single_slide height-800 bg-img background-overlay"
             style="background-image: url('/karl/img/bg-img/bg-2.jpg');">
            <div class="container h-100">
                <div class="row h-100 align-items-center">
                    <div class="col-12">
                        <div class="welcome_slide_text">
                            <h6 data-animation="fadeInDown" data-delay="0" data-duration="500ms">* Ưu đãi duy nhất hôm nay: Miễn phí giao hàng</h6>
                            <h2 data-animation="bounceInDown" data-delay="500ms" data-duration="500ms">Thời trang Nữ</h2>
                            <a asp-controller="Shop" asp-action="Index" class="btn karl-btn"
                               data-animation="fadeInRightBig" data-delay="1s" data-duration="500ms">Xem bộ sưu tập</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ****** New Arrivals Area ****** -->
<section class="new_arrivals_area section_padding_100_0 clearfix">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="section_heading text-center">
                    <h2>Sản phẩm mới về</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="karl-projects-menu mb-100">
        <div class="text-center portfolio-menu">
            <button class="btn active" data-filter="*">TẤT CẢ</button>
            <button class="btn" data-filter=".women">THỜI TRANG NỮ</button>
            <button class="btn" data-filter=".man">THỜI TRANG NAM</button>
            <button class="btn" data-filter=".access">PHỤ KIỆN</button>
            <button class="btn" data-filter=".shoes">GIÀY DÉP</button>
            <button class="btn" data-filter=".kids">TRẺ EM</button>
        </div>
    </div>

    <div class="container">
        <div class="row karl-new-arrivals">
            @for (int i = 1; i <= 6; i++)
            {
                string imgPath = $"/karl/img/product-img/product-{i}.jpg";
                string prodName = $"Jeans midi cocktail dress {i}";
                string prodPrice = "$39.90";

                <div class="col-12 col-sm-6 col-md-4 single_gallery_item women wow fadeInUpBig" data-wow-delay="0.2s">
                    <div class="product-img">
                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@i">
                            <img src="@imgPath" alt="">
                        </a>

                        <!-- Nút Cộng (+): Mở Popup Modal -->
                        <div class="product-quicview">
                            <a href="#" data-toggle="modal" data-target="#quickview"
                               onclick="openQuickView('@i', '@prodName', '@prodPrice', '@imgPath')">
                                <i class="ti-plus"></i>
                            </a>
                        </div>
                    </div>

                    <div class="product-description">
                        <h4 class="product-price">@prodPrice</h4>
                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@i">
                            <p>@prodName</p>
                        </a>

                        <!-- Nút THÊM VÀO GIỎ HÀNG -->
                        <a href="#" data-toggle="modal" data-target="#quickview"
                           onclick="openQuickView('@i', '@prodName', '@prodPrice', '@imgPath')"
                           style="color:#ff084e; font-weight:bold; cursor:pointer; display:inline-block; padding:5px 0; text-transform:uppercase; text-decoration:none;">
                            THÊM VÀO GIỎ HÀNG
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ****** Quick View Modal Area ****** -->
<div class="modal fade" id="quickview" tabindex="-1" role="dialog" aria-labelledby="quickview" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="close btn" data-dismiss="modal" aria-label="Close"
                    style="position: absolute; right: 15px; top: 10px; z-index: 999;">
                <span aria-hidden="true">&times;</span>
            </button>

            <div class="modal-body" style="padding: 30px;">
                <div class="quickview_body">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-12 col-lg-5">
                                <div class="quickview_pro_img text-center">
                                    <img id="qv-image" src="" alt="" style="max-width: 100%; height: auto;">
                                </div>
                            </div>
                            <div class="col-12 col-lg-7">
                                <div class="quickview_pro_des">
                                    <h3 class="title" id="qv-title" style="font-weight: bold;">Tên sản phẩm</h3>
                                    <h4 class="price mb-3" id="qv-price" style="color: #ff084e; font-weight: bold;">$0.00</h4>
                                    <p id="qv-desc" class="mb-4" style="color: #666; line-height: 1.6;">
                                        Sản phẩm thời trang cao cấp thuộc bộ sưu tập Karl Fashion, chất liệu thoáng mát, thiết kế hiện đại phù hợp cho mọi sự kiện.
                                    </p>
                                    <a id="qv-detail-link" href="/Shop/Details/1" class="d-block mb-4"
                                       style="color: #ff084e; font-weight: bold; text-decoration: underline;">
                                        Xem chi tiết sản phẩm &raquo;
                                    </a>
                                </div>

                                <!-- Form gửi giỏ hàng từ Popup -->
                                <form asp-controller="Shop" asp-action="AddToCart" method="post"
                                      class="cart d-flex align-items-center" style="gap: 15px;">
                                    <input type="hidden" name="id" id="qv-id" value="" />

                                    <div class="quantity">
                                        <input type="number" class="form-control text-center" id="qty" step="1" min="1"
                                               max="99" name="quantity" value="1" style="width: 80px; height: 45px;">
                                    </div>

                                    <button type="submit" class="btn"
                                            style="background-color: #ff084e !important; color: #ffffff !important; height: 45px; line-height: 45px; padding: 0 30px; border: none; font-weight: bold; cursor: pointer; opacity: 1 !important;">
                                        THÊM VÀO GIỎ HÀNG
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openQuickView(id, name, price, img) {
            document.getElementById('qv-id').value = id;
            document.getElementById('qv-title').innerText = name;
            document.getElementById('qv-price').innerText = price;
            document.getElementById('qv-image').src = img;

            var detailUrl = '/Shop/Details/' + id;
            var linkElem = document.getElementById('qv-detail-link');
            if (linkElem) {
                linkElem.setAttribute('href', detailUrl);
            }
        }
    </script>
}