@{
    ViewData["Title"] = "Contact Us";
}



<!-- ****** Contact Area Start ****** -->
<div class="contact_area section_padding_100">
    <div class="container">
        <div class="row">
            <!-- Form gửi tin nhắn -->
            <div class="col-12 col-md-6">
                <div class="contact_from">
                    <h2 class="mb-30" style="font-weight: bold; text-transform: uppercase;">Get In Touch</h2>
                    <form action="#" method="post">
                        <div class="form-group mb-3">
                            <input type="text" class="form-control" id="name" placeholder="Họ và tên *" required>
                        </div>
                        <div class="form-group mb-3">
                            <input type="email" class="form-control" id="email" placeholder="Địa chỉ Email *" required>
                        </div>
                        <div class="form-group mb-3">
                            <input type="text" class="form-control" id="subject" placeholder="Tiêu đề">
                        </div>
                        <div class="form-group mb-3">
                            <textarea name="message" class="form-control" id="message" cols="30" rows="6" placeholder="Nội dung lời nhắn *" required></textarea>
                        </div>
                        <button type="submit" class="btn karl-checkout-btn" style="background-color: #ff084e; color: #fff; padding: 12px 30px; border: none; font-weight: bold; border-radius: 0;">
                            SEND MESSAGE
                        </button>
                    </form>
                </div>
            </div>

            <!-- Thông tin liên hệ -->
            <div class="col-12 col-md-6 col-lg-5 ml-lg-auto mt-5 mt-md-0">
                <div class="contact_info_area">
                    <h2 class="mb-30" style="font-weight: bold; text-transform: uppercase;">Contact Info</h2>
                    
                    <div class="single_contact_info d-flex align-items-center mb-3" style="gap: 15px;">
                        <i class="ti-location-pin" style="font-size: 22px; color: #ff084e;"></i>
                        <p class="mb-0"><strong>Địa chỉ:</strong> 123 Đường Lê Lợi, Quận 1, TP. Hồ Chí Minh</p>
                    </div>

                    <div class="single_contact_info d-flex align-items-center mb-3" style="gap: 15px;">
                        <i class="ti-headphone-alt" style="font-size: 22px; color: #ff084e;"></i>
                        <p class="mb-0"><strong>Điện thoại:</strong> +84 123 456 789</p>
                    </div>

                    <div class="single_contact_info d-flex align-items-center mb-3" style="gap: 15px;">
                        <i class="ti-email" style="font-size: 22px; color: #ff084e;"></i>
                        <p class="mb-0"><strong>Email:</strong> support@karlfashion.com</p>
                    </div>

                    <div class="single_contact_info d-flex align-items-center mb-3" style="gap: 15px;">
                        <i class="ti-time" style="font-size: 22px; color: #ff084e;"></i>
                        <p class="mb-0"><strong>Giờ mở cửa:</strong> 08:00 - 22:00 (Thứ 2 - Chủ Nhật)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ****** Contact Area End ****** -->