@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    int id = ViewBag.ProductId ?? 1;
    string name = ViewBag.ProductName ?? "Jeans midi cocktail dress 1";

    // Ép kiểu giá an toàn tránh lỗi RuntimeBinderException
    string price = ViewBag.ProductPrice != null ? ViewBag.ProductPrice.ToString() : "$39.90";
    if (!price.StartsWith("$")) { price = "$" + price; }

    string image = ViewBag.ProductImage ?? "/karl/img/product-img/product-1.jpg";
}

<!-- <<<<<<<<<<<<<<<<<<<< Breadcumb Area Start <<<<<<<<<<<<<<<<<<<< -->
<div class="breadcumb_area">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb d-flex align-items-center">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index">Cửa hàng</a></li>
                    <li class="breadcrumb-item active">@name</li>
                </ol>
                <a asp-controller="Shop" asp-action="Index" class="backToHome d-block">
                    <i class="fa fa-angle-double-left" aria-hidden="true"></i> Quay lại danh mục
                </a>
            </div>
        </div>
    </div>
</div>
<!-- <<<<<<<<<<<<<<<<<<<< Breadcumb Area End <<<<<<<<<<<<<<<<<<<< -->

<!-- <<<<<<<<<<<<<<<<<<<< Single Product Details Area Start >>>>>>>>>>>>>>>>>>>>>>>>> -->
<section class="single_product_details_area section_padding_100">
    <div class="container">
        <div class="row">
            <!-- Hình ảnh sản phẩm -->
            <div class="col-12 col-md-6">
                <div class="single_product_thumb">
                    <div id="product_details_slider" class="carousel slide" data-ride="carousel">
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <a class="gallery_img" href="@image">
                                    <img class="d-block w-100" src="@image" alt="@name">
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thông tin chi tiết sản phẩm -->
            <div class="col-12 col-md-6">
                <div class="single_product_desc">
                    <h4 class="title"><a href="#">@name</a></h4>
                    <h4 class="price" style="color: #ff084e; font-weight: bold;">@price</h4>

                    <p class="available">Tình trạng: <span class="text-muted">Còn hàng</span></p>

                    <div class="single_product_ratings mb-15">
                        <i class="fa fa-star" aria-hidden="true"></i>
                        <i class="fa fa-star" aria-hidden="true"></i>
                        <i class="fa fa-star" aria-hidden="true"></i>
                        <i class="fa fa-star" aria-hidden="true"></i>
                        <i class="fa fa-star-o" aria-hidden="true"></i>
                    </div>

                    <div class="widget size mb-30">
                        <h6 class="widget-title">Kích cỡ</h6>
                        <div class="widget-desc">
                            <ul>
                                <li><a href="#">S</a></li>
                                <li><a href="#">M</a></li>
                                <li><a href="#">L</a></li>
                                <li><a href="#">XL</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Form Thêm vào giỏ hàng -->
                    <form asp-controller="Shop" asp-action="AddToCart" method="post" class="cart clearfix mb-50 d-flex"
                          style="gap: 15px;">
                        <input type="hidden" name="id" value="@id" />
                        <div class="quantity d-flex align-items-center">
                            <button type="button" class="btn btn-outline-secondary"
                                    style="height: 45px; width: 35px; border-radius: 0;"
                                    onclick="var q = document.getElementById('qty'); if(q.value > 1) q.value--;">-</button>
                            <input type="number" class="form-control text-center" id="qty" name="quantity" value="1"
                                   min="1" max="99"
                                   style="width: 50px; height: 45px; border-radius: 0; border-left: 0; border-right: 0;">
                            <button type="button" class="btn btn-outline-secondary"
                                    style="height: 45px; width: 35px; border-radius: 0;"
                                    onclick="var q = document.getElementById('qty'); q.value++;">+</button>
                        </div>

                        <!-- Nút Thêm vào giỏ hàng: Nền đỏ, chữ trắng, hover ra biểu tượng bàn tay (cursor: pointer) -->
                        <button type="submit" class="btn"
                                style="background-color: #ff084e !important; color: #ffffff !important; height: 45px; line-height: 45px; padding: 0 30px; border: none; font-weight: bold; cursor: pointer; opacity: 1 !important;">
                            Thêm vào giỏ hàng
                        </button>
                    </form>

                    <div id="accordion" role="tablist" aria-multiselectable="true">
                        <div class="card">
                            <div class="card-header" role="tab" id="headingOne">
                                <h6 class="mb-0">
                                    <a data-toggle="collapse" href="#collapseOne" aria-expanded="true"
                                       aria-controls="collapseOne">Mô tả sản phẩm</a>
                                </h6>
                            </div>
                            <div id="collapseOne" class="collapse show" role="tabpanel" aria-labelledby="headingOne">
                                <div class="card-body">
                                    <p>Sản phẩm thời trang cao cấp thuộc bộ sưu tập Karl Fashion, chất liệu thoáng mát,
                                        thiết kế hiện đại phù hợp cho mọi sự kiện.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- <<<<<<<<<<<<<<<<<<<< Single Product Details Area End >>>>>>>>>>>>>>>>>>>>>>>>> -->