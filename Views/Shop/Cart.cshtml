@model List<Shop.Models.CartItem>
@{
    ViewData["Title"] = "Cart";
    decimal total = Model != null ? Model.Sum(x => x.Total) : 0m;
}

<div class="cart_area section_padding_100 clearfix">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="cart-table clearfix">
                    <table class="table table-responsive">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="cart_product_img d-flex align-items-center">
                                            <a href="#"><img src="@item.ImageUrl" alt="@item.ProductName"></a>
                                            <h6>@item.ProductName</h6>
                                        </td>
                                        <td class="price"><span>$@item.Price.ToString("F2")</span></td>
                                        <td class="qty">
                                            <span>@item.Quantity</span>
                                        </td>
                                        <td class="total_price"><span>$@item.Total.ToString("F2")</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center">Giỏ hàng của bạn đang trống!</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="cart-footer d-flex mt-30">
                    <div class="back-to-shop w-50">
                        <a asp-controller="Shop" asp-action="Index">Continue shopping</a>
                    </div>
                </div>

            </div>
        </div>

        <div class="row">
            <div class="col-12 col-lg-4 ml-auto">
                <div class="cart-total-area mt-70">
                    <div class="cart-page-heading">
                        <h5>Cart total</h5>
                    </div>

                    <ul class="cart-total-chart">
                        <li><span>Subtotal</span> <span>$@total.ToString("F2")</span></li>
                        <li><span>Shipping</span> <span>Free</span></li>
                        <li><span><strong>Total</strong></span> <span><strong>$@total.ToString("F2")</strong></span></li>
                    </ul>
                    <a asp-controller="Shop" asp-action="Checkout" class="btn karl-checkout-btn">Proceed to checkout</a>
                </div>
            </div>
        </div>
    </div>
</div>