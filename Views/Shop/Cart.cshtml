@model List<Shop.Models.CartItem>

<div class="cart_area section_padding_100 clearfix">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="cart-table clearfix">
                    <table class="table table-responsive">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Tổng tiền</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Hiển thị sản phẩm trong giỏ hàng -->
                            @if (ViewBag.Quantity > 0)
                            {
                                <tr>
                                    <td class="cart_product_img d-flex align-items-center">
                                        <a href="#"><img src="/karl/img/product-img/product-1.jpg" alt="Sản phẩm"></a>
                                        <h6>Jeans midi cocktail dress 1</h6>
                                    </td>
                                    <td class="price"><span>$39.90</span></td>
                                    <td class="qty">
                                        <div class="quantity" style="display: flex; align-items: center; gap: 5px;">
                                            <a asp-controller="Shop" asp-action="UpdateCart" asp-route-id="1" asp-route-quantity="@(ViewBag.Quantity - 1)" class="btn btn-sm btn-outline-secondary">-</a>
                                            <input type="number" class="qty-text form-control text-center" style="width: 50px;" value="@ViewBag.Quantity" readonly>
                                            <a asp-controller="Shop" asp-action="UpdateCart" asp-route-id="1" asp-route-quantity="@(ViewBag.Quantity + 1)" class="btn btn-sm btn-outline-secondary">+</a>
                                        </div>
                                    </td>
                                    <td class="total_price"><span>$@(39.90m * ViewBag.Quantity)</span></td>
                                    <td class="action">
                                        <a asp-controller="Shop" asp-action="RemoveFromCart" asp-route-id="1" class="btn btn-outline-danger btn-sm" style="border-radius: 50%;" title="Xóa">
                                            <i class="ti-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4">
                                        <h5>Giỏ hàng của bạn đang trống!</h5>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Khu vực nút điều hướng & Nút Thanh toán -->
                <div class="cart-footer d-flex justify-content-between align-items-center mt-30">
                    <div class="back-to-shop">
                        <a asp-controller="Shop" asp-action="Index" class="btn karl-checkout-btn" style="background-color: #f5f7fa; color: #000; border: 1px solid #000; padding: 12px 30px; font-weight: bold;">
                            TIẾP TỤC MUA SẮM
                        </a>
                    </div>
                    
                    @if (ViewBag.Quantity > 0)
                    {
                        <div class="proceed-checkout">
                            <a asp-controller="Shop" asp-action="Checkout" class="btn karl-checkout-btn" style="background-color: #ff084e; color: #fff; padding: 12px 30px; font-weight: bold; border-radius: 0;">
                                TIẾP TỤC THANH TOÁN <i class="ti-arrow-right" style="margin-left: 5px;"></i>
                            </a>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>