@model IEnumerable<Shop.Models.Product>

<section class="shop_grid_area section_padding_100">
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-8 col-lg-9">
                <div class="shop_grid_product_area">
                    <div class="row">
                        @for (int i = 1; i <= 9; i++)
                        {
                            <div class="col-12 col-sm-6 col-lg-4 single_gallery_item">
                                <div class="product-img">
                                    <!-- Hình ảnh sản phẩm -->
                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@i">
                                        <img src="~/karl/img/product-img/product-@(i).jpg" alt="">
                                    </a>

                                    <!-- NÚT CỘNG (+) KHI HOVER VÀO HÌNH -->
                                    <div class="product-quicview">
                                        <form asp-controller="Shop" asp-action="AddToCart" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@i" />
                                            <button type="submit" title="Thêm vào giỏ hàng" style="background:none; border:none; color:#fff; font-size:18px; cursor:pointer; width:100%; height:100%;">
                                                <i class="ti-plus"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="product-description">
                                    <h4 class="product-price">$39.90</h4>
                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@i">
                                        <p>Jeans midi cocktail dress @i</p>
                                    </a>

                                    <!-- NÚT THÊM VÀO GIỎ HÀNG Ở DƯỚI HÌNH -->
                                    <form asp-controller="Shop" asp-action="AddToCart" method="post">
                                        <input type="hidden" name="id" value="@i" />
                                        <button type="submit" style="background:none; border:none; color:#ff084e; font-weight:bold; cursor:pointer; padding:5px 0;">
                                            THÊM VÀO GIỎ HÀNG
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>